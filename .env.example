# ---------------------------------------------------------------------------
# HYPE COPILOT — plantilla de entorno. Copiar a .env y rellenar.
# .env está en .gitignore. NUNCA commitear claves.
# ---------------------------------------------------------------------------

# INTERRUPTOR MAESTRO. Con false, ninguna ruta de codigo puede enviar una orden
# real. Cambiarlo requiere aprobacion explicita de Mark + SHADOW superado.
LIVE_EXECUTION=false

# Modo del sistema: RESEARCH | PAPER | SHADOW | TINY | LIVE
# La promocion entre modos es SIEMPRE manual (PRD 14). El codigo nunca la cambia.
HYPE_MODE=RESEARCH

# Base de datos. SQLite para desarrollo local, PostgreSQL en produccion.
DATABASE_URL=sqlite:///./hype_copilot.sqlite3
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/hype_copilot

# Riesgo
HYPE_RISK_USD_PRODUCTION=125.00   # rango permitido $100-$150 (PRD 9.3)
HYPE_EQUITY_USD=1000.00
HYPE_MAX_DATA_AGE_SECONDS=120
HYPE_DAILY_LOSS_LIMIT_PCT=0.01
HYPE_MAX_CONSECUTIVE_LOSSES=3

# Politica SHORT (PRD 4). Cambio de politica explicito de Mark, 2026-09-09.
# Con false, el motor no puede ni siquiera evaluar un short.
HYPE_ALLOW_SHORT=false

# Hyperliquid — datos de mercado (publico, no requiere claves)
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Hyperliquid — EJECUCION. Solo necesario en TINY/LIVE.
# Usar una API wallet de Hyperliquid, NUNCA la clave de la wallet principal.
# Dejar vacio mientras se opere en RESEARCH/PAPER/SHADOW.
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_API_PRIVATE_KEY=

# Webhook de TradingView. Secreto compartido para firmar el payload (PRD 11).
TRADINGVIEW_WEBHOOK_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
